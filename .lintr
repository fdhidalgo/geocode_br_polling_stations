linters: linters_with_defaults(
    line_length_linter = line_length_linter(120),
    object_name_linter = object_name_linter(styles = "snake_case"),
    object_usage_linter = NULL,
    indentation_linter = NULL,
    T_and_F_symbol_linter = T_and_F_symbol_linter(),
    trailing_whitespace_linter = trailing_whitespace_linter(),
    seq_linter = seq_linter(),
    undesirable_function_linter = undesirable_function_linter(
      fun = c(
        "subset" = "Use data.table DT[condition] syntax",
        "transform" = "Use data.table := operator",
        "aggregate" = "Use data.table DT[, .(summary), by = .(groups)]"
      )
    )
  )
exclusions: list("renv", "_targets.R", "R/dev")
encoding: "UTF-8"

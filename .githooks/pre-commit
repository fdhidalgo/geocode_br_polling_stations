#!/bin/sh
# Formatting gate: air (https://posit-dev.github.io/air/).
#
# Runs `air format --check` against the .R files staged for this commit. air is
# an idempotent formatter, so a file that is already formatted passes instantly;
# a file that would be reformatted blocks the commit until you run `air format`.
# The whole repo was formatted once (air.toml, line-width 120), so there is no
# legacy backlog to ratchet down -- every commit just has to stay formatted.
#
# Activate per-clone (once):   git config core.hooksPath .githooks
# Format everything:           air format .
# Bypass for one commit:       git commit --no-verify
# Needs air:                   https://posit-dev.github.io/air/cli.html#installation
#                              (a standalone binary; the hook skips if absent)
#
# Scope note: `air format --check` reads the WORKTREE version of each staged
# file. For a partially staged file the worktree and index can differ; in that
# uncommon case re-stage before committing, or use --no-verify. air's config
# (air.toml) governs formatting and its default excludes (renv/, .git/, ...).
#
# See docs/specs/2026-07-testing-spec.md section 7.

set -e

if ! command -v air >/dev/null 2>&1; then
  echo "pre-commit: air not installed; skipping format gate."
  echo "           install it: https://posit-dev.github.io/air/cli.html#installation"
  exit 0
fi

# Staged R files that were added/copied/modified (not deleted), still on disk.
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.[Rr]$' || true)
files=""
for f in $staged; do
  [ -f "$f" ] && files="$files $f"
done
[ -z "$files" ] && exit 0

# --check exits non-zero and names any file that would be reformatted.
if ! air format --check $files; then
  echo ""
  echo "pre-commit: staged R files are not air-formatted."
  echo "           fix with: air format ${files# }"
  echo "           or bypass with: git commit --no-verify"
  exit 1
fi
echo "pre-commit: staged R files are air-formatted."
